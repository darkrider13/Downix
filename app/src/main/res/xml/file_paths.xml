<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Downloaded update APKs live in cache/updates and are handed to the system installer -->
    <cache-path name="updates" path="updates/" />
    <!-- Android 9 and below: finished downloads are plain files in Downloads (used by Share file) -->
    <external-path name="downloads" path="Download/" />
</paths>
