<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: vector (sharp on every screen), white on transparent -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- ring -->
    <path
        android:pathData="M12,3 A9,9 0 1,1 3.48,14.9"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <!-- progress dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M1.18,14.9 a2.3,2.3 0 1,0 4.6,0 a2.3,2.3 0 1,0 -4.6,0 Z" />
    <!-- arrow -->
    <path
        android:pathData="M12,7.5 L12,15.5 M8.5,12.2 L12,15.7 L15.5,12.2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
